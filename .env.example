DB_HOST=localhost
DB_PORT=3306
DB_NAME=jimi_tracker
DB_USER=root
DB_PASS=your_password_here
WEBHOOK_TOKEN=your_token_here
SYSTEM_VERSION=4.12.5
# URL pública do sistema — base do link "Abrir no sistema" nos e-mails de
# notificação E do botão "Baixar relatório" quando o anexo passa de
# MAIL_MAX_ATTACH_MB. Com esquema (http/https) e SEM barra final.
#
# ⚠️ OBRIGATÓRIA se houver relatório agendado. Faltando esta linha o link sai
# relativo e não abre em caixa de entrada nenhuma. A partir da v4.7.2 o worker
# ABORTA a entrega por link quando ela está vazia (o e-mail de notificação
# apenas omite o botão) — antes, o e-mail saía, o provedor aceitava, o
# histórico marcava "enviado" e só o destinatário descobria o problema.
# Encontrada ausente no homolog em 01/08/2026.
APP_URL=http://your-server
FILE_STORAGE_URL=http://your-server:23010/download/

# ── Extração de vídeo do cartão da câmera (proNo 37382) ────────────────────────
# Destino FTP para onde a CÂMERA envia a gravação pedida em /video/playback.
# O comando 37382 ("FTP file upload command") leva estes campos no payload, e é
# a própria câmera — não o servidor — que abre a conexão FTP e faz o PUT.
#
# ⚠️ A senha NUNCA pode ir para o JavaScript da página. `sendcommand.php` injeta
# estes valores no lado do servidor quando o proNo é 37382, sobrescrevendo o que
# vier do cliente; o browser só manda canal e janela de tempo.
#
# ⚠️ VIDEO_FTP_HOST tem de ser o endereço que a CÂMERA alcança pela internet —
# não `localhost`, não IP de LAN. Ela conecta de fora.
#
# O par natural é o vsftpd do próprio servidor do IoT Hub, cujo diretório é
# servido de volta por FILE_STORAGE_URL: o arquivo entra por FTP e sai por HTTP.
# Sem estas variáveis a tela de playback recusa a extração com uma mensagem
# explícita, em vez de disparar um comando que falharia em silêncio.
VIDEO_FTP_HOST=your-server
VIDEO_FTP_PORT=2121
VIDEO_FTP_USER=dvrupload
VIDEO_FTP_PASS=change_me
# Caminho DENTRO do chroot do usuário FTP ('/' = a raiz dele)
VIDEO_FTP_PATH=/

# Redes pelas quais a câmera pode fazer o download (bitmask do campo
# `condition` do 37382): bit0 WiFi, bit1 LAN, bit2 3G/4G. 7 = as três.
#
# ⚠️ NÃO é opcional. Sem `condition` a câmera **não confirma o comando**: o
# gateway devolve `_code 600 / request timeout` e passa a responder
# `302 Device busy` aos comandos seguintes. Medido em campo — com o campo, a
# mesma câmera respondeu `ok` na hora.
#
# Num rastreador veicular a única rede que existe é a 4G, então tirá-la da
# máscara faz a câmera aceitar e nunca baixar. Em compensação, vídeo por 4G
# consome a franquia do SIM: quem quiser restringir a WiFi usa 1.
VIDEO_FTP_CONDITION=7

# ⚠️ INFRAESTRUTURA, fora do .env: a CÂMERA conecta no FTP **pela internet**.
# Não basta o vsftpd responder no localhost — o roteador precisa encaminhar
# para o servidor a porta de controle (VIDEO_FTP_PORT) **e toda a faixa de
# portas passivas** do vsftpd (pasv_min_port–pasv_max_port). Faltando isso, a
# câmera aceita o comando, tenta, e devolve `result: 1` no
# /pushftpfileupload — sem nunca aparecer no log do FTP.
#
# Testar do LOCALHOST do servidor não prova nada: em 06/08/2026 o FTP
# respondia em 127.0.0.1 e estava inalcançável de fora. A sonda válida é
# `curl --ftp-pasv -u user:senha ftp://IP_PUBLICO:PORTA/` **de outra máquina**.
#
# No homolog (06/08/2026) as portas encaminhadas são **21222** (controle) e
# **31100–31200** (passivas), e o `/etc/vsftpd.conf` foi ajustado para elas:
#   listen_port=21222 | pasv_min_port=31100 | pasv_max_port=31200
#   pasv_address=<IP público>   ← sem isto o cliente recebe um IP de LAN

# Diretório no DISCO onde esses arquivos caem — é o home do usuário FTP acima,
# e também onde o attachment server deposita o VÍDEO DO EVENTO que a câmera
# JIMI sobe sozinha (os `EVENT_<imei>_..._I_15.mp4/.ts` do anexo de alarme).
# A rota /midia lê daqui para servir o vídeo pela origem da aplicação (com
# login e escopo de cliente) — é o que o player da ocorrência e a coluna Vídeo
# do relatório de alarmes usam. O FILE_STORAGE_URL continua existindo, mas não
# é mais usado por tela nenhuma: aquele endpoint não manda CORS (o player de
# MPEG-TS precisa de `fetch`), não aceita Range (sem o qual não se arrasta a
# barra) e responde `Content-Disposition: attachment`. Ver handlers/midia.php.
VIDEO_MEDIA_DIR=/iothub/dvr-upload/uploadFile
# ⚠️ COM O PAINEL EM HTTPS, ISTO **TEM** DE SER HTTPS DA MESMA ORIGEM.
# O player (flv.js) busca o stream por XHR; página https + stream http é
# *mixed content* e o navegador BLOQUEIA — do lado do cliente, sem erro no
# servidor. O comando 37121 responde `ok`, a câmera publica, e o vídeo
# simplesmente não abre. Foi o que aconteceu ao ligar o TLS em 13/08/2026.
#
# A saída é um proxy reverso no Apache (docs/apache/bycamera-stream.conf):
#   /stream/  →  http://127.0.0.1:8881/   com flushpackets=on
# e então STREAM_URL=https://<dominio>/stream
#
# `flushpackets=on` não é ajuste fino: o FLV ao vivo é resposta que nunca
# termina, e sem ele o Apache segura tudo no buffer e o player fica preso em
# "conectando".
STREAM_URL=https://your-domain/stream
# Vídeo ao vivo/playback (JT/T 1078): endereço que o DEVICE alcança para
# publicar o stream (comandos 37121/37377). Sem override, o IP é o host de
# STREAM_URL e as portas são as padrão do iothub-media (10002/10003).
#VIDEO_INGEST_IP=your-server
#VIDEO_INGEST_PORT=10002
#VIDEO_PLAYBACK_PORT=10003
# ⚠️ VIDEO_INGEST_IP passou a ser OBRIGATÓRIA quando STREAM_URL virou domínio.
# Sem ela, o código extrai o host de STREAM_URL — que agora é um NOME, não um
# IP — e manda a câmera publicar em `bycamera.ia.br`. Muitos firmwares não
# resolvem DNS: aceitam o 37121 e nunca publicam. Este campo é para a CÂMERA,
# não para o navegador, e por isso continua sendo o IP público.
#
# Use o IP da LAN do host (não localhost) — consistente com o pushURL dos
# containers do IoTHub, que só alcançam o host pelo IP da rede (ex.: 10.1.0.43)
IOTHUB_COMMAND_URL=http://10.1.0.43:10088/api/device/sendInstruct
IOTHUB_API_TOKEN=123
# Gatilho automático de vídeo de evento (ocorrência nova em câmera JT/T →
# proNo 37384, upload do anexo do alarme pelo alarmLabel). 0 desliga.
# ATTACH_UPLOAD_*: endereço do attachment server do IoTHub QUE O DEVICE
# ALCANÇA (jimi-tracker-upload-process; sem override, usa o IP de ingest do
# vídeo e a porta padrão 21188).
#AUTO_VIDEO_REQUEST=1
#AUTO_VIDEO_TIMEOUT=35
#ATTACH_UPLOAD_IP=your-server
#ATTACH_UPLOAD_PORT=21188
# Logging (core/Logger.php → logs/webhook_YYYY-MM-DD.log).
# LOG_LEVEL=DEBUG liga o RAW_WEBHOOK_DATA (payload bruto de cada webhook) —
# usar temporariamente para diagnosticar device com payload inesperado.
# Retenção/teto aplicados pelo scripts/log_cleanup.php (cron diário 03:10,
# instalado via scripts/crontab-setup.sh).
#LOG_LEVEL=INFO
#LOG_RETENTION_DAYS=30
#LOG_MAX_SIZE_MB=10
# ── Notificações (v4.4.0) ────────────────────────────────────────────
# Sino, pop-up e som funcionam sem SMTP; só o canal de e-mail depende dele.
# O envio acontece no scripts/worker.php (nunca no webhook).
# NOTIFY_ENABLED=0 é o kill-switch global do motor de notificações.
#NOTIFY_ENABLED=1
#
# ── Chave de cifra dos segredos gravados no banco (v4.4.1) ───────────
# Usada para cifrar a senha do SMTP em `smtp_settings` (AES-256-GCM).
# Sem APP_KEY o sistema cai no WEBHOOK_TOKEN — funciona, mas rotacionar o
# token do webhook torna as senhas gravadas indecifráveis (é preciso
# recadastrar). Defina uma chave própria: openssl rand -hex 32
#APP_KEY=
#
# ── SMTP (v4.4.1: preferir o cadastro em /config-smtp) ───────────────
# A partir da v4.4.1 as credenciais são cadastradas pela interface em
# Cadastros › Servidor de E-mail e ficam no banco (senha cifrada), com
# escopo global ou por cliente. As variáveis abaixo permanecem como
# FALLBACK — valem apenas quando não há nada cadastrado. Precedência:
#   credenciais do cliente → servidor global → variáveis abaixo.
#SMTP_HOST=smtp.seuprovedor.com.br
#SMTP_PORT=587
#SMTP_SECURE=tls          # tls (STARTTLS, porta 587) | ssl (implícito, 465) | none
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=nao-responda@suaempresa.com.br
#SMTP_FROM_NAME=bycamera
#SMTP_TIMEOUT=20

# Teto do anexo dos relatórios agendados (v4.7.0), em MB. Acima disso o
# e-mail leva um LINK para /storage/reports em vez do arquivo — provedor
# recusa anexo grande, e e-mail recusado é pior do que link. O link usa
# APP_URL como base, então ela precisa estar correta para o envio agendado.
#MAIL_MAX_ATTACH_MB=5

# Nominatim INTERNO para geocode reverso (v4.8.0). O público impõe 1 req/s, o
# que na prática desligava o recurso: o cache acumulou 82 linhas em meses e a
# tela de Posições resolvia no máximo 3 endereços por página. O interno faz
# ~450 pts/s. Sem esta variável o default abaixo é usado.
#NOMINATIM_URL=http://10.1.0.15:8080

# Validade da listagem de gravações do cartão (v4.9.17), em MINUTOS.
# O cartão é buffer circular e a retenção real depende de quantas horas o
# veículo roda — não existe número fixo de dias. Por isso a lista é um RETRATO
# com hora: vencida, deixa de ser acionável e a tela pede uma nova, em vez de
# oferecer download de arquivo provavelmente já sobrescrito.
# Antes disto a tela mostrava listas de até 32 DIAS como se fossem atuais.
#RESOURCE_LIST_TTL_MINUTES=30

# Retenção dos relatórios gerados (v4.7.1), em dias. O scripts/log_cleanup.php
# (cron diário 03:10) apaga os arquivos de storage/reports mais antigos que
# isso e, junto, as linhas de report_schedule_runs da mesma idade — um
# agendamento diário produz 1 arquivo por dia indefinidamente, e cada arquivo é
# uma cópia de dado de cliente parada em disco. 0 desliga a purga.
# storage/media (vídeo de ocorrência) NÃO é afetado: é evidência, não
# subproduto de consulta.
#REPORT_RETENTION_DAYS=30
